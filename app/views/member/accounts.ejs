<% pageTitle = 'Club Accounts'; active = 'accounts'; %>
<%- include('partials/layout-top', { pageTitle, active }) %>

<h1 class="serif">Club Accounts</h1>
<p class="subtle">View only. This ledger includes every verified payment and approved expense for the whole club.</p>

<div class="summary-cards" style="grid-template-columns: repeat(3,1fr);">
  <div class="summary-card"><div class="num" id="totalCredit">-</div><div class="label">Total Payments Received</div></div>
  <div class="summary-card"><div class="num" id="totalDebit">-</div><div class="label">Total Expenses Approved</div></div>
  <div class="summary-card"><div class="num" id="balance">-</div><div class="label">Club Balance</div></div>
</div>

<div class="card">
  <table>
    <thead><tr><th>Date</th><th>Type</th><th>Member</th><th>Amount</th><th>Description</th></tr></thead>
    <tbody id="rows"><tr><td colspan="5">Loading...</td></tr></tbody>
  </table>
</div>

<script>
  async function load() {
    const res = await fetch('/api/member/ledger');
    if (!res.ok) { window.location.href = '/login.html'; return; }
    const d = await res.json();
    document.getElementById('totalCredit').textContent = fmtMoney(d.total_credit);
    document.getElementById('totalDebit').textContent = fmtMoney(d.total_debit);
    document.getElementById('balance').textContent = fmtMoney(d.total_credit - d.total_debit);
    document.getElementById('rows').innerHTML = d.entries.length ? d.entries.map(e => `
      <tr>
        <td>${fmtDateTime(e.created_at)}</td>
        <td>${e.entry_type === 'credit' ? '<span class="badge active">Payment</span>' : '<span class="badge rejected">Expense</span>'}</td>
        <td>${e.member_name || '-'}</td>
        <td>${fmtMoney(e.amount)}</td>
        <td>${e.description || '-'}</td>
      </tr>`).join('') : '<tr><td colspan="5">No ledger entries yet.</td></tr>';
  }
  load();
</script>

<%- include('partials/layout-bottom') %>
